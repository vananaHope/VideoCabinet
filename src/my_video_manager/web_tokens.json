{
  "colors": {
    "background": "#09090b",
    "foreground": "#fafafa",
    "card": "#18181b",
    "card-foreground": "#fafafa",
    "popover": "#27272a",
    "popover-foreground": "#fafafa",
    "primary": "#4f46e5",
    "primary-foreground": "#ffffff",
    "secondary": "#303036",
    "secondary-foreground": "#fafafa",
    "muted": "#303036",
    "muted-foreground": "#afafb7",
    "accent": "#3f3f46",
    "accent-foreground": "#fafafa",
    "destructive": "#fca5a5",
    "destructive-foreground": "#450a0a",
    "border": "#3f3f46",
    "input": "#7c7c85",
    "ring": "#818cf8",
    "highlight": "#fde047",
    "highlight-open": "#f69b50",
    "highlight-range": "#86efac",
    "highlight-foreground": "#422006",
    "status-success": "#86efac",
    "status-success-foreground": "#052e16",
    "status-info": "#93c5fd",
    "status-info-foreground": "#172554",
    "status-warning": "#fcd34d",
    "status-warning-foreground": "#451a03",
    "primary-text": "#a5b4fc"
  },
  "layout": {
    "radius": "0.75rem",
    "spacing": "0.25rem",
    "grid-row-height": "15.5rem",
    "grid-card-width": "14rem",
    "dialog-list-max-height": "18rem",
    "library-card-small": "11rem",
    "library-card-medium": "15rem",
    "library-card-large": "22rem",
    "library-card-info-height": "6.5rem",
    "content-max-width": "68.75rem",
    "recommendation-card-width": "12.85rem"
  },
  "motion": {
    "motion-duration-quick": "100ms",
    "motion-duration-enter": "150ms",
    "motion-ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "motion-enter-scale": "0.97"
  },
  "typography": {
    "font-sans": "\"Pretendard\", \"Malgun Gothic\", sans-serif",
    "text-xs": "0.75rem",
    "text-sm": "0.875rem",
    "text-base": "1rem",
    "text-lg": "1.125rem",
    "text-xl": "1.25rem",
    "text-2xl": "1.5rem",
    "text-3xl": "1.875rem",
    "roles": {
      "display": { "size": "text-xl", "line-height": "1.75rem", "weight": "600", "letter-spacing": "-0.01em" },
      "page-title": { "size": "text-2xl", "line-height": "2rem", "weight": "600", "letter-spacing": "-0.02em" },
      "section-title": { "size": "text-lg", "line-height": "1.75rem", "weight": "600", "letter-spacing": "-0.01em" },
      "body": { "size": "text-sm", "line-height": "1.25rem", "weight": "400", "letter-spacing": "0em" },
      "body-strong": { "size": "text-sm", "line-height": "1.25rem", "weight": "600", "letter-spacing": "0em" },
      "label": { "size": "text-xs", "line-height": "1rem", "weight": "400", "letter-spacing": "0em" },
      "label-strong": { "size": "text-xs", "line-height": "1rem", "weight": "500", "letter-spacing": "0em" }
    }
  },
  "bundled-font": {
    "weights": {
      "400": "Regular",
      "500": "Medium",
      "600": "SemiBold"
    }
  }
}
